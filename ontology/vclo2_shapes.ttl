@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vclo: <http://synapselex.org/ontology/vclo#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Chặn publish: các bệnh đã đo trong LightRAG store (self-loop, cạnh không type,
# pseudo-entity) phải bị QUARANTINE trước khi vào đồ thị công khai.
# Lưu ý ngữ nghĩa: vclo:at CHỈ bắt buộc với quan hệ LÀM THAY ĐỔI hiệu lực —
# cites/succeeds/guides/contains không tự thay đổi hiệu lực nên không cần at.

vclo:TimeChangingEdgeShape a sh:NodeShape ;
    sh:targetClass rdf:Statement ;
    sh:property [
        sh:path vclo:at ;
        sh:minCount 1 ;
        sh:message "Cạnh reified làm thay đổi hiệu lực phải có mốc thời gian (vclo:at)"@vi ;
    ] .

vclo:EntityTypedShape a sh:NodeShape ;
    sh:targetSubjectsOf skos:altLabel ;
    sh:property [
        sh:path rdf:type ;
        sh:minCount 1 ;
        sh:pattern "^http://synapselex.org/ontology/vclo#" ;
        sh:message "Thực thể canonical phải có ít nhất 1 class thuộc namespace VCLO"@vi ;
    ] .

vclo:EntityLabelShape a sh:NodeShape ;
    sh:targetObjectsOf vclo:aliasOf ;
    sh:property [
        sh:path vclo:preferred_label ;
        sh:minCount 1 ;
        sh:message "Canonical entity phải có preferred_label"@vi ;
    ] .

vclo:NoSelfLoopShape a sh:NodeShape ;
    sh:targetObjectsOf vclo:relatedTo, vclo:cites, vclo:applies, vclo:succeeds ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Cấm self-loop"@vi ;
        sh:select "SELECT $this WHERE { $this ?p $this }" ;
    ] .
